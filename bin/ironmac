#!/usr/bin/env bash
#
# IronMac CLI Entrypoint
#

set -euo pipefail

VERSION="0.1.0"
SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

show_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ██╗██████╗  ██████╗ ███╗   ██╗███╗   ███╗ █████╗  ██████╗"
    echo "  ██║██╔══██╗██╔═══██╗████╗  ██║████╗ ████║██╔══██╗██╔════╝"
    echo "  ██║██████╔╝██║   ██║██╔██╗ ██║██╔████╔██║███████║██║     "
    echo "  ██║██╔══██╗██║   ██║██║╚██╗██║██║╚██╔╝██║██╔══██║██║     "
    echo "  ██║██║  ██║╚██████╔╝██║ ╚████║██║ ╚═╝ ██║██║  ██║╚██████╗"
    echo "  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝     ╚═╝╚═╝  ╚═╝ ╚═════╝"
    echo "             Fortress-Grade Web3 Workstation for macOS (v${VERSION})"
    echo -e "${RESET}"
}

show_help() {
    show_banner
    echo -e "${BOLD}Usage:${RESET} ironmac <command> [options]"
    echo ""
    echo -e "${BOLD}Commands:${RESET}"
    echo "  audit          Run a comprehensive security audit of your Mac"
    echo "  harden         Apply recommended security baselines and network stealth"
    echo "  vault-browser  Create an isolated, dedicated Web3 wallet browser profile"
    echo "  tools          Interactive installer for curated Web3 tools (Foundry, LuLu, etc.)"
    echo "  all            Run the complete guided setup wizard"
    echo "  version        Print IronMac version"
    echo "  help           Display this help message"
    echo ""
}

interactive_menu() {
    show_banner
    echo -e "${BOLD}Please select an action:${RESET}"
    echo "  1) 🔍 Security Health Audit"
    echo "  2) 🔒 Apply System Hardening Baseline"
    echo "  3) 🌐 Create Isolated Vault Browser Profile"
    echo "  4) 📦 Install Curated Web3 Tools & Utilities"
    echo "  5) 🛡️ Run Complete Setup Wizard (All of the above)"
    echo "  0) Exit"
    echo ""
    read -rp "Enter choice [1-5, 0]: " choice
    case "${choice}" in
        1) bash "${SOURCE_DIR}/modules/audit.sh" ;;
        2) bash "${SOURCE_DIR}/modules/harden.sh" ;;
        3) bash "${SOURCE_DIR}/modules/vault_browser.sh" ;;
        4) bash "${SOURCE_DIR}/modules/web3_tools.sh" ;;
        5)
           bash "${SOURCE_DIR}/modules/audit.sh"
           bash "${SOURCE_DIR}/modules/harden.sh"
           bash "${SOURCE_DIR}/modules/vault_browser.sh"
           bash "${SOURCE_DIR}/modules/web3_tools.sh"
           ;;
        0|*) echo "Exiting. Stay safe in Web3!"; exit 0 ;;
    esac
}

CMD="${1:-}"

case "${CMD}" in
    audit)
        bash "${SOURCE_DIR}/modules/audit.sh"
        ;;
    harden)
        bash "${SOURCE_DIR}/modules/harden.sh"
        ;;
    vault-browser)
        bash "${SOURCE_DIR}/modules/vault_browser.sh"
        ;;
    tools)
        bash "${SOURCE_DIR}/modules/web3_tools.sh"
        ;;
    all)
        bash "${SOURCE_DIR}/modules/audit.sh"
        bash "${SOURCE_DIR}/modules/harden.sh"
        bash "${SOURCE_DIR}/modules/vault_browser.sh"
        bash "${SOURCE_DIR}/modules/web3_tools.sh"
        ;;
    version|-v|--version)
        echo "IronMac v${VERSION}"
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        interactive_menu
        ;;
    *)
        echo -e "${RED}Unknown command: ${CMD}${RESET}"
        show_help
        exit 1
        ;;
esac
