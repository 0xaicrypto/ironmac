#!/usr/bin/env bash
#
# IronMac CLI Entrypoint
#

set -euo pipefail

VERSION="0.6.5"
# Resolve real source directory even if called through symlinks (e.g. ~/.local/bin/ironmac)
TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
    DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
SOURCE_DIR="$(cd -P "$(dirname "$TARGET")/.." >/dev/null 2>&1 && pwd)"

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

show_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ██╗██████╗  ██████╗ ███╗   ██╗███╗   ███╗ █████╗  ██████╗"
    echo "  ██║██╔══██╗██╔═══██╗████╗  ██║████╗ ████║██╔══██╗██╔════╝"
    echo "  ██║██████╔╝██║   ██║██╔██╗ ██║██╔████╔██║███████║██║     "
    echo "  ██║██╔══██╗██║   ██║██║╚██╗██║██║╚██╔╝██║██╔══██║██║     "
    echo "  ██║██║  ██║╚██████╔╝██║ ╚████║██║ ╚═╝ ██║██║  ██║╚██████╗"
    echo "  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝     ╚═╝╚═╝  ╚═╝ ╚═════╝"
    echo "             Fortress-Grade Web3 Workstation for macOS (v${VERSION})"
    echo -e "${RESET}"
}

show_help() {
    show_banner
    echo -e "${BOLD}Usage:${RESET} ironmac <command> [options]"
    echo ""
    echo -e "${BOLD}Commands:${RESET}"
    echo "  audit          Run a comprehensive security audit of your Mac"
    echo "  harden         Apply recommended security baselines and network stealth"
    echo "  vault-browser  Create an isolated, dedicated Web3 wallet browser profile"
    echo "  console        Launch AI-native Web3 terminal (Antigravity / Gemini CLI) [--agy|--gemini|--classic]"
    echo "  trap           Anti-AMOS honeypot decoys & tripwire sentry [start|stop|status|test]"
    echo "  clip-guard     Clipboard address swap detector & 30s key auto-wipe [start|stop|status|clear|test]"
    echo "  panic          Emergency air-gap: instant Wi-Fi shutdown & threat isolation [trigger|restore]"
    echo "  tools          Interactive installer for curated Web3 tools (Foundry, LuLu, etc.)"
    echo "  mcp            Run Model Context Protocol (MCP) server for AI Agents (Cursor/Claude)"
    echo "  app            Launch native macOS MenuBar companion HUD (shield in top bar)"
    echo "  raycast        Install or inspect Raycast script command integrations"
    echo "  all            Run the complete guided setup wizard"
    echo "  version        Print IronMac version"
    echo "  help           Display this help message"
    echo ""
}

interactive_menu() {
    show_banner
    echo -e "${BOLD}Please select an action:${RESET}"
    echo "  1) 🔍 Security Health Audit"
    echo "  2) 🔒 Apply System Hardening Baseline"
    echo "  3) 🌐 Create Isolated Vault Browser Profile"
    echo "  4) 💻 Launch Secure Vault Console (AI Copilot: agy / gemini & RAM-backed)"
    echo "  5) 🪤 Anti-AMOS Honeypot Trap (Deploy Decoys & Tripwire Sentry)"
    echo "  6) 📋 Clipboard Guard (Address Swap Detection & 30s Key Auto-Purge)"
    echo "  7) 🚨 Emergency Panic Air-Gap (Instant Wi-Fi Drop & Threat Isolation)"
    echo "  8) 📦 Install Curated Web3 Tools & Utilities"
    echo "  9) ⚡ Run Complete Setup Wizard (All of the above)"
    echo " 10) 🖥️ Launch macOS MenuBar Companion HUD"
    echo " 11) ⚡ Show Raycast Script Command Integrations"
    echo "  0) Exit"
    echo ""
    read -rp "Enter choice [1-11, 0]: " choice
    case "${choice}" in
        1) bash "${SOURCE_DIR}/modules/audit.sh" ;;
        2) bash "${SOURCE_DIR}/modules/harden.sh" ;;
        3) bash "${SOURCE_DIR}/modules/vault_browser.sh" ;;
        4) exec bash "${SOURCE_DIR}/modules/console.sh" ;;
        5) bash "${SOURCE_DIR}/modules/trap.sh" start ;;
        6) bash "${SOURCE_DIR}/modules/clip_guard.sh" start ;;
        7) bash "${SOURCE_DIR}/modules/panic.sh" trigger ;;
        8) bash "${SOURCE_DIR}/modules/web3_tools.sh" ;;
        9)
           bash "${SOURCE_DIR}/modules/audit.sh"
           bash "${SOURCE_DIR}/modules/harden.sh"
           bash "${SOURCE_DIR}/modules/vault_browser.sh" --init-only
           bash "${SOURCE_DIR}/modules/console.sh"
           bash "${SOURCE_DIR}/modules/trap.sh" start
           bash "${SOURCE_DIR}/modules/clip_guard.sh" start
           bash "${SOURCE_DIR}/modules/web3_tools.sh"
           ;;
        10)
           bash "${SOURCE_DIR}/bin/ironmac" app
           ;;
        11)
           bash "${SOURCE_DIR}/bin/ironmac" raycast
           ;;
        0|*) echo "Exiting. Stay safe in Web3!"; exit 0 ;;
    esac
}

CMD="${1:-}"

case "${CMD}" in
    audit)
        bash "${SOURCE_DIR}/modules/audit.sh"
        ;;
    harden)
        bash "${SOURCE_DIR}/modules/harden.sh"
        ;;
    vault-browser)
        bash "${SOURCE_DIR}/modules/vault_browser.sh" "${@:2}"
        ;;
    console)
        exec bash "${SOURCE_DIR}/modules/console.sh" "${@:2}"
        ;;
    trap)
        bash "${SOURCE_DIR}/modules/trap.sh" "${2:-status}"
        ;;
    clip-guard)
        bash "${SOURCE_DIR}/modules/clip_guard.sh" "${2:-status}"
        ;;
    panic)
        bash "${SOURCE_DIR}/modules/panic.sh" "${2:-trigger}" "${3:-}"
        ;;
    tools)
        bash "${SOURCE_DIR}/modules/web3_tools.sh"
        ;;
    wallets)
        TARGET_ALIAS="${2:-}"
        PERM_DIR="${HOME}/.ironmac/keystores"
        echo -e "\033[1;38;5;51m⚡ IronMac Vault Wallets & Keystores:\033[0m"
        found=0
        if [[ -d "$PERM_DIR" ]]; then
            for k in "$PERM_DIR"/*.json; do
                [[ -e "$k" ]] || continue
                [[ "$k" == *".keystore.json" ]] && continue
                alias="$(basename "$k" .json)"
                [[ -n "$TARGET_ALIAS" && "$alias" != "$TARGET_ALIAS" ]] && continue
                addr="$(grep '"address"' "$k" 2>/dev/null | awk -F'"' '{print $4}')"
                chain="$(grep '"chain"' "$k" 2>/dev/null | awk -F'"' '{print $4}')"
                echo -e "  • \033[1;38;5;214m${alias}\033[0m [${chain:-base}] \033[38;5;141m🔐 (Permanent Keystore / Enclave)\033[0m: \033[38;5;82m${addr}\033[0m"
                ((found++))
            done
        fi
        for vol in /Volumes/IronVault*; do
            [[ -d "$vol/keys" ]] || continue
            for k in "$vol/keys"/*.json; do
                [[ -e "$k" ]] || continue
                [[ "$k" == *".keystore.json" ]] && continue
                alias="$(basename "$k" .json)"
                [[ -n "$TARGET_ALIAS" && "$alias" != "$TARGET_ALIAS" ]] && continue
                [[ -f "${PERM_DIR}/${alias}.json" ]] && continue
                addr="$(grep '"address"' "$k" 2>/dev/null | awk -F'"' '{print $4}')"
                chain="$(grep '"chain"' "$k" 2>/dev/null | awk -F'"' '{print $4}')"
                echo -e "  • \033[1;38;5;214m${alias}\033[0m [${chain:-base}] \033[38;5;220m⚡ (RAMDisk Burner)\033[0m: \033[38;5;82m${addr}\033[0m"
                ((found++))
            done
        done
        if [[ $found -eq 0 ]]; then
            echo -e "  \033[38;5;242mNo wallets configured yet. Ask AI or run: cast wallet new\033[0m"
        else
            echo -e "\033[38;5;242m(To securely copy private key to clipboard under Touch ID, run: ironmac reveal <alias>)\033[0m"
        fi
        ;;
    reveal)
        ALIAS="${2:-}"
        if [[ -z "$ALIAS" ]]; then
            echo "Usage: ironmac reveal <alias>"
            exit 1
        fi
        PERM_DIR="${HOME}/.ironmac/keystores"
        META_FILE=""
        RAM_DIR=""
        for vol in /Volumes/IronVault*; do
            [[ -d "$vol/keys" ]] && RAM_DIR="$vol/keys"
        done
        if [[ -f "${PERM_DIR}/${ALIAS}.json" ]]; then
            META_FILE="${PERM_DIR}/${ALIAS}.json"
        elif [[ -n "$RAM_DIR" && -f "${RAM_DIR}/${ALIAS}.json" ]]; then
            META_FILE="${RAM_DIR}/${ALIAS}.json"
        else
            echo -e "\033[31mWallet '${ALIAS}' not found.\033[0m"
            exit 1
        fi
        AUTH_BIN="${SOURCE_DIR}/bin/ironmac-auth"
        [[ ! -x "$AUTH_BIN" ]] && AUTH_BIN="/opt/homebrew/Cellar/ironmac/0.6.3/libexec/bin/ironmac-auth"
        if [[ -x "$AUTH_BIN" ]]; then
            TICKET_ARG=()
            for vol in /Volumes/IronVault*; do
                [[ -d "$vol" ]] && TICKET_ARG=("--ticket" "$vol/.auth_ticket" "--ttl" "600")
            done
            if ! "$AUTH_BIN" "Authorize exporting private key for '${ALIAS}'" "${TICKET_ARG[@]}" >/dev/null 2>&1; then
                echo -e "\033[31mTouch ID authorization was rejected or cancelled.\033[0m"
                exit 1
            fi
        fi
        PKEY=""
        IS_KS="$(grep '"keystore_file"' "$META_FILE" 2>/dev/null | awk -F'"' '{print $4}')"
        if [[ -n "$IS_KS" ]]; then
            PASS="$(security find-generic-password -a "$ALIAS" -s "ironmac.vault.keystore" -w 2>/dev/null || true)"
            if [[ -z "$PASS" ]]; then
                echo -e "\033[31mFailed to retrieve encryption key from Apple Keychain.\033[0m"
                exit 1
            fi
            KS_PATH="${PERM_DIR}/${ALIAS}.keystore.json"
            [[ ! -f "$KS_PATH" && -n "$RAM_DIR" ]] && KS_PATH="${RAM_DIR}/${ALIAS}.keystore.json"
            PKEY="$(node -e "
                const fs = require('fs');
                const crypto = require('crypto');
                try {
                    const ks = JSON.parse(fs.readFileSync(process.argv[1], 'utf8'));
                    const pass = process.argv[2];
                    const c = ks.crypto || ks.Crypto;
                    const salt = Buffer.from(c.kdfparams.salt, 'hex');
                    const n = c.kdfparams.n || 8192;
                    const r = c.kdfparams.r || 8;
                    const p = c.kdfparams.p || 1;
                    const dklen = c.kdfparams.dklen || 32;
                    const derivedKey = crypto.scryptSync(Buffer.from(pass, 'utf-8'), salt, dklen, { N: n, r, p, maxmem: 128 * 1024 * 1024 });
                    const cipherKey = derivedKey.subarray(0, 16);
                    const iv = Buffer.from(c.cipherparams.iv, 'hex');
                    const decipher = crypto.createDecipheriv('aes-128-ctr', cipherKey, iv);
                    const ciphertext = Buffer.from(c.ciphertext, 'hex');
                    const privKey = Buffer.concat([decipher.update(ciphertext), decipher.final()]);
                    process.stdout.write('0x' + privKey.toString('hex'));
                } catch(e) { process.exit(1); }
            " "$KS_PATH" "$PASS" 2>/dev/null || true)"
        else
            PKEY="$(grep '"private_key"' "$META_FILE" 2>/dev/null | awk -F'"' '{print $4}')"
        fi
        if [[ -z "$PKEY" || "$PKEY" != 0x* ]]; then
            echo -e "\033[31mFailed to decrypt or extract private key for '${ALIAS}'.\033[0m"
            exit 1
        fi
        echo -n "$PKEY" | pbcopy
        echo -e "\033[38;5;82m✔ Private key for '${ALIAS}' copied directly to clipboard via Touch ID/Passkey.\033[0m"
        echo -e "\033[38;5;242m  [Screen display suppressed for anti-shoulder surfing protection]\033[0m"
        echo -e "\033[38;5;242m  [ClipGuard active: clipboard will auto-purge sensitive key data in 30s]\033[0m"
        ;;
    mcp)
        shift || true
        exec node "${SOURCE_DIR}/mcp/dist/index.js" "$@"
        ;;
    app|menu)
        MENU_BIN="${SOURCE_DIR}/bin/ironmac-menu"
        TARGET_BIN="$MENU_BIN"
        if [[ ! -w "${SOURCE_DIR}/bin" ]]; then
            TARGET_BIN="${HOME}/.ironmac/bin/ironmac-menu"
            mkdir -p "${HOME}/.ironmac/bin"
        fi

        if [[ ! -x "$TARGET_BIN" || "${SOURCE_DIR}/app/IronMacMenu.swift" -nt "$TARGET_BIN" ]]; then
            echo "Compiling native Swift MenuBar companion..."
            swiftc -O "${SOURCE_DIR}/app/IronMacMenu.swift" -o "$TARGET_BIN"
            chmod +x "$TARGET_BIN"
        fi
        MENU_BIN="$TARGET_BIN"

        if pgrep -x "ironmac-menu" >/dev/null 2>&1; then
            pkill -x "ironmac-menu" 2>/dev/null || true
            sleep 0.5
        fi

        nohup "$MENU_BIN" >/dev/null 2>&1 &
        disown $! 2>/dev/null || true
        echo -e "${GREEN}✓ IronMac MenuBar Companion launched!${RESET} Look for the fortress shield icon in the top right menu bar."
        ;;
    raycast)
        RAY_DIR="${SOURCE_DIR}/integrations/raycast"
        echo -e "${CYAN}${BOLD}⚡ IronMac Raycast Script Commands:${RESET}"
        echo -e "Directory: ${BOLD}${RAY_DIR}${RESET}"
        echo ""
        echo "Included Commands:"
        echo "  • ⚡ Defense HUD Telemetry   : integrations/raycast/ironmac-hud.sh"
        echo "  • 🌐 Launch Vault Browser    : integrations/raycast/ironmac-browser.sh"
        echo "  • 📶 Toggle Hardware Air-Gap : integrations/raycast/ironmac-airgap.sh"
        echo "  • 🔍 Verify Crypto Address   : integrations/raycast/ironmac-verify-address.sh"
        echo "  • ⚡ Launch IronVault Console : integrations/raycast/ironmac-console.sh"
        echo "  • 🚨 EMERGENCY PANIC KILL    : integrations/raycast/ironmac-panic.sh"
        echo "  • 🔑 Scan Secrets in Path    : integrations/raycast/ironmac-scan-secrets.sh"
        echo ""
        echo "To add into Raycast:"
        echo "  1. Open Raycast Preferences -> Extensions -> Script Commands"
        echo "  2. Click 'Add Directories' and select: ${RAY_DIR}"
        echo ""
        ;;
    all)
        bash "${SOURCE_DIR}/modules/audit.sh"
        bash "${SOURCE_DIR}/modules/harden.sh"
        bash "${SOURCE_DIR}/modules/vault_browser.sh" --init-only
        bash "${SOURCE_DIR}/modules/web3_tools.sh"
        ;;
    version|-v|--version)
        echo "IronMac v${VERSION}"
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        interactive_menu
        ;;
    *)
        echo -e "${RED}Unknown command: ${CMD}${RESET}"
        show_help
        exit 1
        ;;
esac
