#!/usr/bin/env bash
#
# IronMac CLI Entrypoint
#

set -euo pipefail

VERSION="0.4.0"
# Resolve real source directory even if called through symlinks (e.g. ~/.local/bin/ironmac)
TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
    DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
SOURCE_DIR="$(cd -P "$(dirname "$TARGET")/.." >/dev/null 2>&1 && pwd)"

BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

show_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ██╗██████╗  ██████╗ ███╗   ██╗███╗   ███╗ █████╗  ██████╗"
    echo "  ██║██╔══██╗██╔═══██╗████╗  ██║████╗ ████║██╔══██╗██╔════╝"
    echo "  ██║██████╔╝██║   ██║██╔██╗ ██║██╔████╔██║███████║██║     "
    echo "  ██║██╔══██╗██║   ██║██║╚██╗██║██║╚██╔╝██║██╔══██║██║     "
    echo "  ██║██║  ██║╚██████╔╝██║ ╚████║██║ ╚═╝ ██║██║  ██║╚██████╗"
    echo "  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝╚═╝     ╚═╝╚═╝  ╚═╝ ╚═════╝"
    echo "             Fortress-Grade Web3 Workstation for macOS (v${VERSION})"
    echo -e "${RESET}"
}

show_help() {
    show_banner
    echo -e "${BOLD}Usage:${RESET} ironmac <command> [options]"
    echo ""
    echo -e "${BOLD}Commands:${RESET}"
    echo "  audit          Run a comprehensive security audit of your Mac"
    echo "  harden         Apply recommended security baselines and network stealth"
    echo "  vault-browser  Create an isolated, dedicated Web3 wallet browser profile"
    echo "  console        Launch a zero-trace, ephemeral RAM-backed secure terminal"
    echo "  trap           Anti-AMOS honeypot decoys & tripwire sentry [start|stop|status|test]"
    echo "  clip-guard     Clipboard address swap detector & 30s key auto-wipe [start|stop|status|clear|test]"
    echo "  panic          Emergency air-gap: instant Wi-Fi shutdown & threat isolation [trigger|restore]"
    echo "  tools          Interactive installer for curated Web3 tools (Foundry, LuLu, etc.)"
    echo "  mcp            Run Model Context Protocol (MCP) server for AI Agents (Cursor/Claude)"
    echo "  app            Launch native macOS MenuBar companion HUD (shield in top bar)"
    echo "  raycast        Install or inspect Raycast script command integrations"
    echo "  all            Run the complete guided setup wizard"
    echo "  version        Print IronMac version"
    echo "  help           Display this help message"
    echo ""
}

interactive_menu() {
    show_banner
    echo -e "${BOLD}Please select an action:${RESET}"
    echo "  1) 🔍 Security Health Audit"
    echo "  2) 🔒 Apply System Hardening Baseline"
    echo "  3) 🌐 Create Isolated Vault Browser Profile"
    echo "  4) 💻 Launch Secure Vault Console (Zero-History & RAM-backed)"
    echo "  5) 🪤 Anti-AMOS Honeypot Trap (Deploy Decoys & Tripwire Sentry)"
    echo "  6) 📋 Clipboard Guard (Address Swap Detection & 30s Key Auto-Purge)"
    echo "  7) 🚨 Emergency Panic Air-Gap (Instant Wi-Fi Drop & Threat Isolation)"
    echo "  8) 📦 Install Curated Web3 Tools & Utilities"
    echo "  9) 🛡️ Run Complete Setup Wizard (All of the above)"
    echo " 10) 🖥️ Launch macOS MenuBar Companion HUD"
    echo " 11) ⚡ Show Raycast Script Command Integrations"
    echo "  0) Exit"
    echo ""
    read -rp "Enter choice [1-11, 0]: " choice
    case "${choice}" in
        1) bash "${SOURCE_DIR}/modules/audit.sh" ;;
        2) bash "${SOURCE_DIR}/modules/harden.sh" ;;
        3) bash "${SOURCE_DIR}/modules/vault_browser.sh" ;;
        4) exec bash "${SOURCE_DIR}/modules/console.sh" ;;
        5) bash "${SOURCE_DIR}/modules/trap.sh" start ;;
        6) bash "${SOURCE_DIR}/modules/clip_guard.sh" start ;;
        7) bash "${SOURCE_DIR}/modules/panic.sh" trigger ;;
        8) bash "${SOURCE_DIR}/modules/web3_tools.sh" ;;
        9)
           bash "${SOURCE_DIR}/modules/audit.sh"
           bash "${SOURCE_DIR}/modules/harden.sh"
           bash "${SOURCE_DIR}/modules/vault_browser.sh"
           bash "${SOURCE_DIR}/modules/console.sh"
           bash "${SOURCE_DIR}/modules/trap.sh" start
           bash "${SOURCE_DIR}/modules/clip_guard.sh" start
           bash "${SOURCE_DIR}/modules/web3_tools.sh"
           ;;
        10)
           bash "${SOURCE_DIR}/bin/ironmac" app
           ;;
        11)
           bash "${SOURCE_DIR}/bin/ironmac" raycast
           ;;
        0|*) echo "Exiting. Stay safe in Web3!"; exit 0 ;;
    esac
}

CMD="${1:-}"

case "${CMD}" in
    audit)
        bash "${SOURCE_DIR}/modules/audit.sh"
        ;;
    harden)
        bash "${SOURCE_DIR}/modules/harden.sh"
        ;;
    vault-browser)
        bash "${SOURCE_DIR}/modules/vault_browser.sh"
        ;;
    console)
        exec bash "${SOURCE_DIR}/modules/console.sh"
        ;;
    trap)
        bash "${SOURCE_DIR}/modules/trap.sh" "${2:-status}"
        ;;
    clip-guard)
        bash "${SOURCE_DIR}/modules/clip_guard.sh" "${2:-status}"
        ;;
    panic)
        bash "${SOURCE_DIR}/modules/panic.sh" "${2:-trigger}" "${3:-}"
        ;;
    tools)
        bash "${SOURCE_DIR}/modules/web3_tools.sh"
        ;;
    mcp)
        shift || true
        exec node "${SOURCE_DIR}/mcp/dist/index.js" "$@"
        ;;
    app|menu)
        MENU_BIN="${SOURCE_DIR}/bin/ironmac-menu"
        if [[ ! -x "$MENU_BIN" ]]; then
            TARGET_BIN="$MENU_BIN"
            if [[ ! -w "${SOURCE_DIR}/bin" ]]; then
                TARGET_BIN="${HOME}/.ironmac/bin/ironmac-menu"
                mkdir -p "${HOME}/.ironmac/bin"
            fi
            echo "Compiling native Swift MenuBar companion..."
            swiftc -O "${SOURCE_DIR}/app/IronMacMenu.swift" -o "$TARGET_BIN"
            chmod +x "$TARGET_BIN"
            MENU_BIN="$TARGET_BIN"
        fi
        if pgrep -f "ironmac-menu" >/dev/null; then
            echo -e "${GREEN}● IronMac MenuBar companion is already active.${RESET} Look for 🛡️ in your top menu bar."
        else
            nohup "$MENU_BIN" >/dev/null 2>&1 &
            echo -e "${GREEN}✓ IronMac MenuBar Companion launched!${RESET} Look for 🛡️ in the top right menu bar."
        fi
        ;;
    raycast)
        RAY_DIR="${SOURCE_DIR}/integrations/raycast"
        echo -e "${CYAN}${BOLD}⚡ IronMac Raycast Script Commands:${RESET}"
        echo -e "Directory: ${BOLD}${RAY_DIR}${RESET}"
        echo ""
        echo "Included Commands:"
        echo "  • 🛡️ Defense HUD Telemetry   : integrations/raycast/ironmac-hud.sh"
        echo "  • 📶 Toggle Hardware Air-Gap : integrations/raycast/ironmac-airgap.sh"
        echo "  • 🔍 Verify Crypto Address   : integrations/raycast/ironmac-verify-address.sh"
        echo "  • ⚡ Launch IronVault Console : integrations/raycast/ironmac-console.sh"
        echo "  • 🚨 EMERGENCY PANIC KILL    : integrations/raycast/ironmac-panic.sh"
        echo "  • 🔑 Scan Secrets in Path    : integrations/raycast/ironmac-scan-secrets.sh"
        echo ""
        echo "To add into Raycast:"
        echo "  1. Open Raycast Preferences -> Extensions -> Script Commands"
        echo "  2. Click 'Add Directories' and select: ${RAY_DIR}"
        echo ""
        ;;
    all)
        bash "${SOURCE_DIR}/modules/audit.sh"
        bash "${SOURCE_DIR}/modules/harden.sh"
        bash "${SOURCE_DIR}/modules/vault_browser.sh"
        bash "${SOURCE_DIR}/modules/web3_tools.sh"
        ;;
    version|-v|--version)
        echo "IronMac v${VERSION}"
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        interactive_menu
        ;;
    *)
        echo -e "${RED}Unknown command: ${CMD}${RESET}"
        show_help
        exit 1
        ;;
esac
